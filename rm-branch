#!/usr/bin/env bash

set -euo pipefail

git for-each-ref --format='%(refname:short)' refs/heads/ \
  | while read -r branch; do
      if [[ "$branch" == "main" ]]; then
        continue
      fi

      printf "Delete '%s'? [y/N] " "$branch"
      read -r answer < /dev/tty

      if [[ "$answer" == [yY] ]]; then
        git branch -D "$branch"
      else
        printf "Skipped '%s'.\n" "$branch"
      fi
    done
